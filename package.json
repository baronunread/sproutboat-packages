{
  "name": "sproutboat-packages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baronunread/sproutboat-packages.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test packages/",
    "test:native-crypto": "bun packages/runtime/test/native-crypto.ts",
    "test:native-utf8": "bun packages/runtime/test/native-utf8.ts",
    "scorecard": "bun scripts/porffor-scorecard.ts",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "test:native-iterators": "bun packages/runtime/test/native-iterators.ts",
    "gen:streams": "bun packages/runtime/src/gen-streams.ts",
    "test:native-streams": "bun packages/runtime/test/native-streams.ts",
    "test:native-model-resolver": "bun packages/runtime/test/native-model-resolver.ts",
    "test:native-base64": "bun packages/runtime/test/native-base64.ts",
    "test:native-timers": "bun packages/runtime/test/native-timers.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@oxlint/plugins": "1.82.0",
    "bun-types": "^1.4.2",
    "oxlint": "1.82.0",
    "typescript": "^7.0.2",
    "web-streams-polyfill": "4.3.0"
  }
}
