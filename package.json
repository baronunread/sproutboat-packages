{
  "name": "sproutboat-packages",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baronunread/sproutboat-packages.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "lefthook install || true",
    "test": "bun run build:sql-budget && bun test packages/",
    "test:native": "bun scripts/test-native.ts",
    "test:native-crypto": "bun packages/runtime/test/native-crypto.ts",
    "test:native-utf8": "bun packages/runtime/test/native-utf8.ts",
    "scorecard": "bun scripts/porffor-scorecard.ts",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "test:native-iterators": "bun packages/runtime/test/native-iterators.ts",
    "gen:streams": "bun packages/runtime/src/gen-streams.ts",
    "test:native-streams": "bun packages/runtime/test/native-streams.ts",
    "test:native-model-resolver": "bun packages/runtime/test/native-model-resolver.ts",
    "test:native-base64": "bun packages/runtime/test/native-base64.ts",
    "test:native-timers": "bun packages/runtime/test/native-timers.ts",
    "build:sql-budget": "bun packages/wire/src/build-d1-budget.ts",
    "test:native-response-defaults": "bun packages/runtime/test/native-response-defaults.ts",
    "test:native-raw-body": "bun packages/runtime/test/native-raw-body.ts",
    "test:native-url": "bun packages/runtime/test/native-url.ts",
    "test:native-json": "bun packages/runtime/test/native-json.ts",
    "test:native-errors": "bun packages/runtime/test/native-errors.ts",
    "test:native-events": "bun packages/runtime/test/native-events.ts",
    "test:native-request": "bun packages/runtime/test/native-request.ts",
    "test:native-waituntil": "bun packages/runtime/test/native-waituntil.ts",
    "test:native-web-apis": "bun packages/runtime/test/native-web-apis.ts",
    "test:native-bodies": "bun packages/runtime/test/native-bodies.ts",
    "test:native-streaming": "bun packages/runtime/test/native-streaming.ts",
    "test:native-service-bindings": "bun packages/runtime/test/native-service-bindings.ts",
    "test:native-fetch-request": "bun packages/runtime/test/native-fetch-request.ts",
    "test:native-ltx": "bun packages/runtime/test/native-ltx.ts",
    "test:native-d1": "bun packages/runtime/test/native-d1.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@oxlint/plugins": "1.82.0",
    "bun-types": "^1.4.2",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.82.0",
    "typescript": "^7.0.2",
    "web-streams-polyfill": "4.3.0"
  }
}
