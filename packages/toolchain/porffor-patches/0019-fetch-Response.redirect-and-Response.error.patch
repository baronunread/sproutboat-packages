From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sproutboat <noreply@sproutboat.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH] fetch: Response.redirect and Response.error

internal/fetch.js defines only Response.json; two corpus apps throw on their redirect branches
without redirect() and error().

Class: upstream
Pass: patchResponseStatics
Upstream: https://github.com/CanadaHonk/porffor/issues/463
---
 runtime/node/internal/fetch.js | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/runtime/node/internal/fetch.js b/runtime/node/internal/fetch.js
index 0861e7a2c15b87f1070d7dbc15eba5988fa628be..1a71d1ad408baba7390bebb6bc094fb6666e3cdf 100644
--- a/runtime/node/internal/fetch.js
+++ b/runtime/node/internal/fetch.js
@@ -431,5 +431,19 @@ export class Response {
     if (!new Headers(init.headers).has('content-type')) response.headers.set('content-type', 'application/json');
     return response;
   }
+
+  // sproutboat: Response.redirect and Response.error
+  static redirect(url, status = 302) {
+    status = Number(status);
+    if (status !== 301 && status !== 302 && status !== 303 && status !== 307 && status !== 308) throw new RangeError(`Invalid status code ${status}`);
+    return new Response(null, { status, headers: { location: new URL(String(url)).href } });
+  }
+
+  static error() {
+    const response = new Response(null, { status: 200 });
+    response.status = 0;
+    response.type = 'error';
+    return response;
+  }
 }
 Object.assign(Response.prototype, bodyMethods);
