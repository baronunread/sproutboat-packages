From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sproutboat <noreply@sproutboat.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH] codegen: shared dispatch arguments are evaluated in order
 (P10)

A method call on a receiver of unknown type goes through a dispatch function shared per method and
argument count, and the call site hands the argument expressions straight to the C call, where their
order is unspecified. x.toString("utf8", index, index += length) (postgres.js decodes every DataRow
value this way) read `index` after the increment on arm64 and returned "". The direct-call paths
already evaluate each argument into a local first; this one now does too.
Related family, different code paths: #437, #438, #448.

Class: upstream
Pass: patchDispatchArgOrder (P10)
Upstream: https://github.com/CanadaHonk/porffor/issues/454
---
 compiler/codegen.js | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/compiler/codegen.js b/compiler/codegen.js
index 96582f4c5c3bfba75a6f9cf61db78e0b199d796e..4bb0e7012eb88d43348b4c69dc5496d3b27236bf 100644
--- a/compiler/codegen.js
+++ b/compiler/codegen.js
@@ -2351,7 +2351,8 @@ const generateCall = (scope, decl) => {
           Object.keys(protoBC).length > 1 && !decl.arguments.some(x => x?.type === 'SpreadElement')) {
           const params = decl.arguments.map((_, i) => 'a' + i);
           const func = sharedFunc(`((${[ 'r', ...params ].join(', ')}) => r.${protoName}(${params.join(', ')}))`, scope, protoName + '_' + params.length);
-          return Call(func.index, [ targetTmp, ...args.map(x => coerceValue(generate(scope, x), T.jsval)) ], func.retType);
+          // sproutboat P10: shared dispatch arguments are evaluated in order
+          return Call(func.index, [ targetTmp, ...args.map(x => reuse(scope, coerceValue(generate(scope, x), T.jsval))) ], func.retType);
         }
 
         const entries = Object.keys(protoBC).map(x => [ +x, protoBC[x] ]).sort((a, b) => a[0] - b[0]);
