 static int porf_gc_install_run(i32 ci, u32 pg) {
+  if ((porf_gc_pages[pg].flags & PORF_GC_PF_SEALED) != 0u) return 0;
   struct porf_gc_window* w = &porf_gc_active[ci];
   struct porf_gc_page* m = &porf_gc_pages[pg];
   const u32 cls = porf_gc_cls_size[ci];
@@ -2883,7 +2891,7 @@ ${st}void porf_gc_barrier_reclassify(u32 p, i32 type) {
   } else if (k == PORF_GC_PK_SPAN) {
     if ((p & PORF_GC_SPAGE_MASK) != 0u) return;
   } else return;
-  porf_gc_kinds[p >> 4] = (u8)type;
+  if (porf_gc_kinds[p >> 4] != (u8)type) porf_gc_kinds[p >> 4] = (u8)type;
 }
 // only old blocks need cards, young ones (and window blocks, with no alloc bit) are traced in full
 static inline int porf_gc_old_block(u32 p) {
@@ -3032,7 +3040,7 @@ static void porf_gc_mark_raw(i32 body) {
   const u32 g = porf_gc_gran(body);
   if (porf_gc_bit(PORF_GC_B_ALLOC, g) == 0u) return;
   if (porf_gc_minor_mode && porf_gc_bit(PORF_GC_B_YOUNG, g) == 0u) return;
-  porf_gc_bit_set(PORF_GC_B_MARK, g);
+  if (porf_gc_bit(PORF_GC_B_MARK, g) == 0u) porf_gc_bit_set(PORF_GC_B_MARK, g);
 }
 
 static void porf_gc_mark_boxed_primitive(f64 value, i32 type) {
@@ -3475,6 +3483,7 @@ static void porf_gc_mark_js_now(f64 value, i32 type) {
   // static strings hold no references and are never freed
   if ((u32)body < porf_heap_base && (type == ${TYPES.bytestring} || type == ${TYPES.string})) return;
   if (porf_gc_is_block_start(body)) {
+    if (porf_gc_template_top != 0 && (u32)body < porf_gc_template_top && (porf_gc_pages[(u32)body >> PORF_GC_SPAGE_SHIFT].flags & PORF_GC_PF_SEALED) != 0u) return;
     // skip header reads for old or already-marked blocks
     const u32 g = porf_gc_gran(body);
     if (porf_gc_minor_mode && porf_gc_bit(PORF_GC_B_YOUNG, g) == 0u) return;
@@ -4015,14 +4024,14 @@ static void porf_gc_scan_cards(void) {
       porf_gc_scan_young_seen = 0;
       porf_gc_scan_card(c);
       porf_gc_drain_mark_queue();
-      porf_gc_cards[c] = porf_gc_scan_young_seen;
+      porf_gc_cards[c] = c < (porf_gc_template_top >> 9) ? 1u : porf_gc_scan_young_seen;
