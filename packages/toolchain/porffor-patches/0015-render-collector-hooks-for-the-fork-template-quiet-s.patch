 static void porf_gc_partial_push(u32 pg) {
   struct porf_gc_page* m = &porf_gc_pages[pg];
-  if ((m->flags & PORF_GC_PF_PARTIAL) != 0u) return;
+  if ((m->flags & (PORF_GC_PF_PARTIAL | PORF_GC_PF_SEALED)) != 0u) return;
   m->flags |= PORF_GC_PF_PARTIAL;
   m->aux = porf_gc_partial[m->cidx];
   porf_gc_partial[m->cidx] = pg + 1u;
@@ -4191,9 +4200,19 @@ static u64 porf_gc_settled_live(void) {
 }
 
 // while most allocations survive the budget is twice live
+static u64 porf_gc_limit_bytes = 0;
+${st}void porf_gc_set_limit(u64 bytes) { porf_gc_limit_bytes = bytes; }
+static u64 porf_gc_limit_room(void) {
+  if (porf_gc_limit_bytes == 0) return ~0ull;
+  const u64 live = porf_gc_last_live_bytes + (porf_gc_promoted_since_full > 0 ? (u64)porf_gc_promoted_since_full : 0u);
+  const u64 room = porf_gc_limit_bytes > live ? (porf_gc_limit_bytes - live) / 2u : 0u;
+  return room > 1048576ull ? room : 1048576ull;
+}
 static i64 porf_gc_budget(void) {
   const i64 grown = (i64)porf_gc_last_live_bytes * 2;
-  return porf_gc_survival > 50 && grown > (i64)porf_gc_nursery_bytes ? grown : (i64)porf_gc_nursery_bytes;
+  const i64 want = porf_gc_survival > 50 && grown > (i64)porf_gc_nursery_bytes ? grown : (i64)porf_gc_nursery_bytes;
+  const u64 room = porf_gc_limit_room();
+  return (u64)want > room ? (i64)room : want;
 }
 
 static void porf_gc_cycle(i64 allocated) {
@@ -4202,7 +4221,9 @@ static void porf_gc_cycle(i64 allocated) {
   porf_gc_busy = 1;
   // a small heap's nursery stays near eight times what is live: fewer gcs past that only cost memory
   const u64 near_live = porf_gc_last_live_bytes * 8u < 1048576ull ? 1048576ull : porf_gc_last_live_bytes * 8u;
-  const u32 cap = porf_gc_last_live_bytes >= 8388608ull ? 33554432u : near_live < 8388608ull ? (u32)near_live : 8388608u;
+  const u32 cap_free = porf_gc_last_live_bytes >= 8388608ull ? 33554432u : near_live < 8388608ull ? (u32)near_live : 8388608u;
+  const u64 cap_room = porf_gc_limit_room();
+  const u32 cap = cap_free > cap_room ? (u32)cap_room : cap_free;
   if (ms < 50 && porf_gc_nursery_bytes * 2u <= cap) porf_gc_nursery_bytes <<= 1;
     else if ((ms > 1000 || porf_gc_nursery_bytes > cap) && porf_gc_nursery_bytes > 1048576u) porf_gc_nursery_bytes >>= 1;
   // only full gcs while the heap is small or most allocations survive
@@ -4226,6 +4247,59 @@ ${st}void porf_gc_idle(void) {
   porf_gc_collect(0);
   porf_gc_discard_free_runs(1u);
 }
+// sproutboat: collector hooks for the fork template
+${st}void porf_gc_quiet(void) {
+  porf_gc_busy = 0;
+  porf_gc_nursery_bytes = 1048576u;
+  porf_gc_collect(0);
+  porf_gc_discard_free_runs(1u);
+}
+${st}void porf_gc_seal_heap(void) {
+  if (porf_heap_base == 0) return;
+  porf_gc_quiet();
+  for (i32 ci = 0; ci < PORF_GC_NCLASSES; ci++) {
+    struct porf_gc_window* w = &porf_gc_active[ci];
+    if (w->end != 0) porf_gc_publish_window(ci);
+    w->cur = w->end = w->lo = 0;
+    while (porf_gc_partial[ci] != 0) {
+      struct porf_gc_page* m = &porf_gc_pages[porf_gc_partial[ci] - 1u];
+      porf_gc_partial[ci] = m->aux;
+      m->aux = 0;
+      m->flags &= (u8)~PORF_GC_PF_PARTIAL;
+    }
+  }
+  // every page in use is sealed (tails too) and its live objects stay marked for the life of every worker
+  const u32 top = porf_heap_top >> PORF_GC_SPAGE_SHIFT;
+  for (u32 pg = porf_heap_base >> PORF_GC_SPAGE_SHIFT; pg < top; pg++) {
+    const u8 k = porf_gc_page_kind[pg];
+    if (k == 0u) continue;
+    porf_gc_pages[pg].flags |= PORF_GC_PF_SEALED;
+    if (k == PORF_GC_PK_SMALL) {
+      if ((porf_gc_pages[pg].flags & PORF_GC_PF_TAIL) != 0u) continue;
+      u64* blk = porf_gc_meta + ((size_t)pg << 5);
+      const u32 npg = porf_gc_cls_pages[porf_gc_pages[pg].cidx];
+      for (u32 w = 0; w < npg * 8u; w++) blk[((size_t)w << 2) + PORF_GC_B_MARK] = blk[((size_t)w << 2) + PORF_GC_B_ALLOC];
+    } else if (k == PORF_GC_PK_SPAN) porf_gc_bit_set(PORF_GC_B_MARK, porf_gc_gran(pg << PORF_GC_SPAGE_SHIFT));
+  }
+  porf_gc_template_top = porf_heap_top;
+  porf_gc_template_live = porf_gc_last_live_bytes;
+}
+// cards below the template top are sticky (never cleared): every collection scans them
+static void porf_gc_scan_template_cards(void) {
+  const u32 c_lo = porf_heap_base >> 9;
+  const u32 c_hi = porf_gc_template_top >> 9;
+  for (u32 cw = c_lo & ~7u; cw < c_hi; cw += 8u) {
+    u64 w8;
+    memcpy(&w8, porf_gc_cards + cw, 8);
+    if (w8 == 0) continue;
+    for (u32 j = 0; j < 8u; j++) {
+      const u32 c = cw + j;
+      if (c < c_lo || c >= c_hi || porf_gc_cards[c] == 0) continue;
+      porf_gc_scan_card(c);
+      porf_gc_drain_mark_queue();
+    }
+  }
+}
 
 static void porf_gc_clear_marks(u32 lo, u32 hi) {
   for (size_t w = (size_t)(lo >> 4 >> 6); w < (size_t)(((hi >> 4) + 63u) >> 6); w++)
@@ -4242,10 +4316,13 @@ ${st}void porf_gc_collect(int minor) {
     porf_gc_claimed_since_full = 0;
     porf_gc_promoted_since_full = 0;
     // the skipped alias window holds no blocks, writing its marks would only dirty pages
-    if (porf_gc_alias_lo < porf_heap_top && porf_gc_alias_hi > porf_heap_base) {
-      porf_gc_clear_marks(porf_heap_base, porf_gc_alias_lo);
+    const u32 clear_lo = porf_gc_template_top != 0 && porf_gc_template_top < porf_heap_top ? porf_gc_template_top : porf_gc_template_top != 0 ? porf_heap_top : porf_heap_base;
+    for (u32 pg = porf_heap_base >> PORF_GC_SPAGE_SHIFT; pg < (clear_lo >> PORF_GC_SPAGE_SHIFT); pg++)
+      if (porf_gc_page_kind[pg] != 0u && (porf_gc_pages[pg].flags & PORF_GC_PF_SEALED) == 0u) porf_gc_clear_marks(pg << PORF_GC_SPAGE_SHIFT, (pg + 1u) << PORF_GC_SPAGE_SHIFT);
+    if (porf_gc_alias_lo < porf_heap_top && porf_gc_alias_hi > clear_lo) {
+      if (porf_gc_alias_lo > clear_lo) porf_gc_clear_marks(clear_lo, porf_gc_alias_lo);
       porf_gc_clear_marks(porf_gc_alias_hi, porf_heap_top);
-    } else porf_gc_clear_marks(porf_heap_base, porf_heap_top);
+    } else porf_gc_clear_marks(clear_lo, porf_heap_top);
   }
   porf_gc_static_marks_len = 0;
   if (porf_gc_static_marks != NULL) memset(porf_gc_static_marks, 0, (size_t)porf_gc_static_marks_cap * sizeof(*porf_gc_static_marks));
@@ -4259,6 +4336,7 @@ ${st}void porf_gc_collect(int minor) {
   porf_gc_mark_global_roots();
   porf_gc_drain_mark_queue();
   if (minor) porf_gc_scan_cards();
+  else if (porf_gc_template_top != 0) porf_gc_scan_template_cards();
   porf_gc_mark_global_raw_roots();
   porf_gc_drain_mark_queue();
   porf_gc_process_weakmaps();
@@ -4293,15 +4371,17 @@ ${st}void porf_gc_collect(int minor) {
     const u32 top = porf_heap_top >> PORF_GC_SPAGE_SHIFT;
     for (u32 pg = porf_heap_base >> PORF_GC_SPAGE_SHIFT; pg < top; pg++) {
       const u8 k = porf_gc_page_kind[pg];
+      if ((porf_gc_pages[pg].flags & PORF_GC_PF_SEALED) != 0u) continue;
       if (k == PORF_GC_PK_SMALL) {
         if ((porf_gc_pages[pg].flags & PORF_GC_PF_TAIL) != 0u) continue;
         porf_gc_sweep_page_small(pg, 0, &promoted, &live_bytes);
       } else if (k == PORF_GC_PK_SPAN) porf_gc_sweep_span(pg, 0, &promoted, &live_bytes);
     }
+    live_bytes += porf_gc_template_live;
     porf_gc_last_live_bytes = live_bytes;
     porf_gc_record_live(live_bytes);
     porf_gc_live_bytes = live_bytes;
-    memset(porf_gc_cards + (porf_heap_base >> 9), 0, (size_t)((porf_heap_top - porf_heap_base) >> 9) + 1);
+    if (porf_gc_template_top < porf_heap_top) memset(porf_gc_cards + ((porf_gc_template_top > porf_heap_base ? porf_gc_template_top : porf_heap_base) >> 9), 0, (size_t)((porf_heap_top - (porf_gc_template_top > porf_heap_base ? porf_gc_template_top : porf_heap_base)) >> 9) + 1);
     porf_gc_run_cache_drain();
     porf_gc_retreat_heap_top();
     // free pages a busy program will reuse soon stay, more than that go back
