From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sproutboat <noreply@sproutboat.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH] compiler: SB_EXTRA_LINK and SB_EXTRA_CFLAGS add link inputs
 and C flags

The C the platform links in (SQLite, BearSSL, the broker and R2 transfer glue) needs extra
link inputs and compiler flags that come from the environment of whoever builds. Upstream
names libraries in source (Porffor.link) and has no environment hook.

Class: ours
Pass: patchCompilerArgsA21
---
 compiler/index.js | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/compiler/index.js b/compiler/index.js
index 38d58a779040b2770cc5ab79ac6b1699a4f35a57..acf8454a9712ba418ab3cad0b5b19cbc36c6f8b9 100644
--- a/compiler/index.js
+++ b/compiler/index.js
@@ -195,6 +195,7 @@ export default (code, module = Prefs.module, opts = {}) => {
         // js arithmetic rounds every op, no fused multiply-add
         '-ffp-contract=off',
         ...darwinReleaseCompileArgs,
+        ...(process.env.SB_EXTRA_CFLAGS ? process.env.SB_EXTRA_CFLAGS.split(' ').filter(Boolean) : []),
         ...compilerArgs,
         // linux has no continuous mode without it, and only compiles take it
         ...(Prefs.pgoGen && process.platform !== 'darwin' ? [ '-mllvm', '-runtime-counter-relocation' ] : []),
@@ -247,6 +248,7 @@ export default (code, module = Prefs.module, opts = {}) => {
         '-o', outFile, // set path for output
         ...(uws ? [ uws.archive ] : []),
         ...(adaLib ? [ adaLib.archive ] : []),
+        ...(process.env.SB_EXTRA_LINK ? process.env.SB_EXTRA_LINK.split(' ').filter(Boolean) : []),
         '-lm', // link math.h
         ...libs.ldflags,
         ...(objects ? [ ...compilerArgs, `-O${Prefs.O ?? 3}` ] : []),
