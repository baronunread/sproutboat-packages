From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sproutboat <noreply@sproutboat.com>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH] render: select is a reserved C name

A top-level binding named `select` fails the C compile on Linux: glibc's sys/select.h declares
select() and the reserved-name list lacks it. #426 (ours, closed) fixed all-caps macro names only;
lowercase libc functions are still missing from cReservedNames.

Class: upstream
Pass: patchReservedSelect
Upstream: https://github.com/CanadaHonk/porffor/issues/462
---
 compiler/render.js | 1 +
 1 file changed, 1 insertion(+)

diff --git a/compiler/render.js b/compiler/render.js
index 817af18a9180d3fcc8e7345ddb443726a6589e97..135904f906aefe6c93b999cde0a36c07e449f27c 100644
--- a/compiler/render.js
+++ b/compiler/render.js
@@ -35,6 +35,7 @@ const BIN_PREC = {
 };
 
 const cReservedNames = new Set([
+  'select', // sproutboat: glibc select: sys/select.h redeclares it
   'auto', 'break', 'case', 'char', 'const', 'continue', 'default', 'do', 'double',
   'else', 'enum', 'extern', 'float', 'for', 'goto', 'if', 'inline', 'int', 'long',
   'register', 'restrict', 'return', 'short', 'signed', 'sizeof', 'static', 'struct',
