{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
    "packages/runtime/src/native-fetch-prelude.js",
    "packages/runtime/src/transport-*.js",
    "packages/runtime/src/streams-entry.js",
    "packages/toolchain/src/case-map.ts",
    "packages/toolchain/scorecards/**",
    "packages/toolchain/vendor/**",
    "packages/wire/native/**",
    "**/CHANGELOG.md",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.css"
  ]
}
